<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.minesweeper.controller.Controller">

        <HBox alignment="CENTER" spacing="200">

            <ComboBox fx:id="difficulty" prefWidth="100">

                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Easy" />
                        <String fx:value="Medium" />
                        <String fx:value="Hard" />
                        <String fx:value="Custom" />
                    </FXCollections>
                </items>

                <value>
                    <String fx:value="Easy" />
                </value>
            </ComboBox>

            <Button fx:id="restartButton" text="Restart" onAction="#restart"/>

            <Label fx:id="scoreLabel" text="Score: 0"/>

        </HBox>


        <HBox fx:id="customPane" alignment="CENTER" spacing="10"
              visible="false" managed="false">
            <Label text="Height:"/>
            <TextField fx:id="customRow" text="30" prefWidth="70"/>
            <Label text="Width:"/>
            <TextField fx:id="customColumn" text="30" prefWidth="70"/>
            <Label text="Mines:"/>
            <TextField fx:id="customMineNum" text="30" prefWidth="70"/>
            <Button fx:id="updateCustomButton" text="Update" onAction="#updateCustom"/>
        </HBox>

        <Label fx:id="resultLabel" text="Win/Lose"/>

        <GridPane fx:id="gameGridPane" style="-fx-background-color: #e0e0e0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        </GridPane>


</VBox>
