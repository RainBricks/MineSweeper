<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.minesweeper.view.CustomDialogController">

    <headerText>
        Set custom game parameters
    </headerText>

    <content>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label text="Height:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="rowField" prefWidth="100" text="8" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Width:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="colField" prefWidth="100" text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Mines:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
         <Label fx:id="warningLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="mineField" prefWidth="100" text="10" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </content>
</DialogPane>
